rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'benkarroshani@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection validation / test probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User activities subcollection
      match /activities/{activityId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Civic Waste Issue Reports
    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.reporterId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Community Wall Posts
    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'Approved' ||
                     (isSignedIn() && resource.data.authorId == request.auth.uid) ||
                     isAdmin();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin() ||
                       (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy'])) ||
                       (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // Admin role store
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
