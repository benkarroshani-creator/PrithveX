rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'benkarroshani@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection validation / test probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // Civic Waste Issue Reports - Public transparency for municipal complaints & status
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Community Wall Posts - Public circularity actions, ideas, and engagement
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // Waste Buyers Directory
    match /wasteBuyers/{buyerId} {
      allow read: if true;
      allow write: if true;
    }

    // Marketplace Listings
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Marketplace Enquiries
    match /marketplaceEnquiries/{enquiryId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Directory Corrections and User Suggestions
    match /directoryCorrections/{correctionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // User Profiles & Impact stats
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) || !isSignedIn() || isAdmin();
      allow delete: if isAdmin();

      // User activities subcollection
      match /activities/{activityId} {
        allow read, write: if isOwner(userId) || isAdmin() || !isSignedIn();
      }
    }

    // Admin role store
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default-deny for any unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
